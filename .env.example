# DOCKER
# Image name used by `task build-image` and `task push-image`.
# Set the registry/repository where your built images should be stored.
IMAGE_REPOSITORY=ghcr.io/your-user/mesh-observer
IMAGE_TAG=latest

# MQTT
# Connection settings used by the observer to subscribe to Meshtastic MQTT topics.
# Point these to the broker you want the application to read from.
MQTT_BROKER=tcp://localhost:1883
MQTT_TOPIC_FILTER=msh/+/2/json/#
MQTT_QOS=1

# REDIS
# Connection and retention settings for the Redis instance used during aggregation.
# Redis stores short-lived observation state and cached node metadata.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EVENT_TTL_SECONDS=300
REDIS_POSITION_TTL_SECONDS=86400

# LOCAL SERVICE STARTUP
# Optional ports used by the bundled tasks to start local Mosquitto and Redis containers.
# Leave these empty if you want to use services that are already running elsewhere.
START_MQTT_BROKER_ON_PORT=
START_REDIS_ON_PORT=

# MAP GENERATION
# Optional static map rendering attached to final reports.
# Disable this if you only want text output in Telegram or logs.
MAP_IMAGE_ENABLED=false
MAP_IMAGE_WIDTH=1024
MAP_IMAGE_HEIGHT=768
MAP_PROVIDER_URL=https://staticmap.openstreetmap.de/staticmap.php

# GENERAL SETTINGS
# Core observer behavior such as aggregation timing and message formatting.
# These defaults are fine for most local and small-scale deployments.
AGGREGATION_WINDOW_SECONDS=60
CLEANUP_INTERVAL_SECONDS=5
MESSAGE_PREVIEW_LEN=80
MAX_OBSERVATIONS_PER_MESSAGE=100

# TELEGRAM
# Optional Telegram delivery settings for live propagation reports.
# Leave these empty to log reports locally instead of sending them to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
